  "operational_event_sinks": [
    {
      "file": "src/services/telegram_observability/events.py",
      "name": "NoOpTelegramOperationalEventSink",
      "line_start": 10,
      "line_end": 21,
      "source": "class NoOpTelegramOperationalEventSink:\n    \"\"\"\n    Sink padrão sem saída.\n    \"\"\"\n\n    __slots__ = ()\n\n    def emit(\n        self,\n        event: TelegramOperationalEvent,\n    ) -> None:\n        del event"
    },
    {
      "file": "src/services/telegram_observability/events.py",
      "name": "InMemoryTelegramOperationalEventSink",
      "line_start": 24,
      "line_end": 93,
      "source": "class InMemoryTelegramOperationalEventSink:\n    \"\"\"\n    Armazena eventos sanitizados para testes.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._events: list[\n            TelegramOperationalEvent\n        ] = []\n\n        self._lock = RLock()\n\n    def emit(\n        self,\n        event: TelegramOperationalEvent,\n    ) -> None:\n        if not isinstance(\n            event,\n            TelegramOperationalEvent,\n        ):\n            raise TypeError(\n                \"event deve ser TelegramOperationalEvent.\"\n            )\n\n        with self._lock:\n            self._events.append(event)\n\n    def snapshot(\n        self,\n    ) -> tuple[\n        TelegramOperationalEvent,\n        ...,\n    ]:\n        with self._lock:\n            return tuple(\n                self._events\n            )\n\n    def clear(self) -> None:\n        with self._lock:\n            self._events.clear()\n\n    def count(\n        self,\n        *,\n        name: str | None = None,\n        component: str | None = None,\n        outcome: str | None = None,\n        level: str | None = None,\n    ) -> int:\n        return sum(\n            1\n            for event in self.snapshot()\n            if (\n                name is None\n                or event.name == name\n            )\n            and (\n                component is None\n                or event.component == component\n            )\n            and (\n                outcome is None\n                or event.outcome == outcome\n            )\n            and (\n                level is None\n                or event.level == level\n            )\n        )"
    },
    {
      "file": "src/services/telegram_observability/contracts.py",
      "name": "TelegramOperationalEvent",
      "line_start": 205,
      "line_end": 273,
      "source": "class TelegramOperationalEvent:\n    name: str\n    level: str\n    component: str\n    outcome: str\n    fields: Mapping[str, object] = field(\n        default_factory=dict\n    )\n\n    def __post_init__(self) -> None:\n        name = str(\n            self.name\n        ).strip()\n\n        if not name:\n            raise ValueError(\n                \"name não pode ser vazio.\"\n            )\n\n        if not name.startswith(\n            \"telegram_\"\n        ):\n            raise ValueError(\n                \"Eventos Telegram devem começar com telegram_.\"\n            )\n\n        object.__setattr__(\n            self,\n            \"name\",\n            name,\n        )\n\n        object.__setattr__(\n            self,\n            \"level\",\n            _validate_choice(\n                field_name=\"level\",\n                value=self.level,\n                allowed=ALLOWED_EVENT_LEVELS,\n            ),\n        )\n\n        object.__setattr__(\n            self,\n            \"component\",\n            _validate_choice(\n                field_name=\"component\",\n                value=self.component,\n                allowed=ALLOWED_METRIC_COMPONENTS,\n            ),\n        )\n\n        object.__setattr__(\n            self,\n            \"outcome\",\n            _validate_choice(\n                field_name=\"outcome\",\n                value=self.outcome,\n                allowed=ALLOWED_OUTCOMES,\n            ),\n        )\n\n        object.__setattr__(\n            self,\n            \"fields\",\n            MappingProxyType(\n                dict(self.fields)\n            ),\n        )"
    },
    {
      "file": "src/services/telegram_observability/contracts.py",
