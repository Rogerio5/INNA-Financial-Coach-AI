APP_NAME=inna-financial-coach-ai
APP_ENV=development

INNA_MOCK_MODE=true
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/inna_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
TELEGRAM_ENABLED=false

# Supervisor híbrido
INNA_SUPERVISOR_MODEL=gemini-3.5-flash-lite
INNA_SUPERVISOR_TIMEOUT_MS=10000
INNA_SUPERVISOR_RETRY_ATTEMPTS=1
INNA_SUPERVISOR_MAX_OUTPUT_TOKENS=220
INNA_SUPERVISOR_MAX_CONTEXT_CHARS=8000
INNA_SUPERVISOR_TOTAL_DEADLINE_MS=8000
RUN_LIVE_GEMINI_TESTS=0
INNA_EDUCATION_MODEL=gemini-3.5-flash-lite
INNA_RAG_MODEL=gemini-3.5-flash-lite
INNA_REPORT_MODEL=gemini-3.5-flash-lite
INNA_FINANCIAL_EXPLANATION_MODEL=gemini-3.5-flash-lite
INNA_RAG_TOOL_TIMEOUT_SECONDS=20
INNA_FINANCIAL_TOOL_TIMEOUT_SECONDS=2
INNA_FINANCIAL_HISTORY_TOOL_TIMEOUT_SECONDS=15
INNA_POSTGRES_NETWORK_FAMILY=ipv4
INNA_POSTGRES_CONNECT_TIMEOUT_SECONDS=8
INNA_POSTGRES_DNS_CACHE_TTL_SECONDS=60
# Autenticação interna entre Streamlit e API
INNA_INTERNAL_API_SIGNING_SECRET=
INNA_INTERNAL_API_MAX_CLOCK_SKEW_SECONDS=300

# Segurança do webhook Telegram
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# INNA Telegram Operational Status
# =============================================================================

# Habilita a rota protegida GET /internal/ready.
# Em produção, mantenha false se o diagnóstico interno não for necessário.
INNA_INTERNAL_READY_ENABLED=false

# Token exclusivo da rota operacional interna.
# Obrigatório apenas quando INNA_INTERNAL_READY_ENABLED=true.
# Gere um valor aleatório com pelo menos 32 caracteres.
# Nunca coloque o token real neste arquivo.
INNA_INTERNAL_OPERATIONS_TOKEN=

# Tempo durante o qual um resultado de readiness pode ser reutilizado.
# Faixa válida: 0 a 60 segundos.
INNA_READINESS_CACHE_TTL_SECONDS=1

# Tempo máximo que uma chamada concorrente aguarda uma avaliação já em andamento.
# Faixa válida: 0 a 10 segundos.
INNA_READINESS_CONCURRENT_WAIT_SECONDS=0.25

# Orçamento total da avaliação de readiness.
# Faixa válida: 0.001 a 30 segundos.
INNA_READINESS_EVALUATION_BUDGET_SECONDS=2
# Sentence-Window Retrieval — Semana 3
INNA_RAG_SENTENCE_WINDOW_ENABLED=false
INNA_RAG_SENTENCE_WINDOW_SIZE=2
INNA_RAG_SENTENCE_WINDOW_CHUNK_RADIUS=1
INNA_RAG_SENTENCE_WINDOW_MAX_CHARACTERS=4000
INNA_MCP_CLIENT_TOKEN=
INNA_MCP_AUDIT_PATH=artifacts/audits/mcp_calls.jsonl
INNA_MCP_DB_AUDIT_ENABLED=false
