APP_NAME=inna-financial-coach-ai
APP_ENV=development

INNA_MOCK_MODE=true
GEMINI_API_KEY=coloque_sua_chave_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash-lite
INNA_GEMINI_BILLING_MODE=free_tier

API_HOST=127.0.0.1
API_PORT=8000

DATABASE_URL=postgresql://postgres:sua_senha_aqui@localhost:5432/inna_db

# Telegram Bot
TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
TELEGRAM_ENABLED=false

# Supervisor híbrido
INNA_SUPERVISOR_MODEL=gemini-2.5-flash-lite
INNA_SUPERVISOR_TIMEOUT_MS=10000
INNA_SUPERVISOR_RETRY_ATTEMPTS=1
INNA_SUPERVISOR_MAX_OUTPUT_TOKENS=220
INNA_SUPERVISOR_MAX_CONTEXT_CHARS=8000
INNA_SUPERVISOR_TOTAL_DEADLINE_MS=8000
RUN_LIVE_GEMINI_TESTS=0
INNA_EDUCATION_MODEL=gemini-2.5-flash-lite
INNA_RAG_MODEL=gemini-2.5-flash-lite
INNA_REPORT_MODEL=gemini-2.5-flash-lite
INNA_FINANCIAL_EXPLANATION_MODEL=gemini-2.5-flash-lite
INNA_RAG_TOOL_TIMEOUT_SECONDS=20
INNA_FINANCIAL_TOOL_TIMEOUT_SECONDS=2
INNA_FINANCIAL_HISTORY_TOOL_TIMEOUT_SECONDS=15
INNA_POSTGRES_NETWORK_FAMILY=ipv4
INNA_POSTGRES_CONNECT_TIMEOUT_SECONDS=8
INNA_POSTGRES_DNS_CACHE_TTL_SECONDS=60
# Autenticação interna entre Streamlit e API
INNA_INTERNAL_API_SIGNING_SECRET=
INNA_INTERNAL_API_MAX_CLOCK_SKEW_SECONDS=300

# Segurança do webhook Telegram
TELEGRAM_WEBHOOK_SECRET=

# =============================================================================
# INNA Telegram Operational Status
# =============================================================================

# Habilita a rota protegida GET /internal/ready.
# Em produção, mantenha false se o diagnóstico interno não for necessário.
INNA_INTERNAL_READY_ENABLED=false

# Token exclusivo da rota operacional interna.
# Obrigatório apenas quando INNA_INTERNAL_READY_ENABLED=true.
# Gere um valor aleatório com pelo menos 32 caracteres.
# Nunca coloque o token real neste arquivo.
INNA_INTERNAL_OPERATIONS_TOKEN=

# Tempo durante o qual um resultado de readiness pode ser reutilizado.
# Faixa válida: 0 a 60 segundos.
INNA_READINESS_CACHE_TTL_SECONDS=1

# Tempo máximo que uma chamada concorrente aguarda uma avaliação já em andamento.
# Faixa válida: 0 a 10 segundos.
INNA_READINESS_CONCURRENT_WAIT_SECONDS=0.25

# Orçamento total da avaliação de readiness.
# Faixa válida: 0.001 a 30 segundos.
INNA_READINESS_EVALUATION_BUDGET_SECONDS=2

# Auto-Merging Retrieval experimental
# Desligado por padrao ate conclusao do A/B e Quality Gate.
INNA_RAG_AUTO_MERGING_ENABLED=false
INNA_RAG_AUTO_MERGING_PARENT_SIZE=3
INNA_RAG_AUTO_MERGING_MIN_CHILDREN=2
INNA_RAG_AUTO_MERGING_MAX_CHARACTERS=4000

# Knowledge Graph / Neo4j
INNA_KNOWLEDGE_GRAPH_ENABLED=false
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_CA_BUNDLE_MODE=system
# GraphRAG Retrieval
INNA_RAG_GRAPH_ENABLED=false
INNA_RAG_GRAPH_CONCEPT_LIMIT=3
INNA_RAG_GRAPH_CHUNK_LIMIT=8

# LlamaIndex Agentic RAG
INNA_LLAMAINDEX_AGENTIC_RAG_ENABLED=false

# Native A2A Gateway
# Public URL announced by the A2A Agent Card.
INNA_A2A_PUBLIC_BASE_URL=https://inna-api.onrender.com

# Secret bearer token. Configure the real value only
# in the production environment. Minimum: 32 characters.
INNA_A2A_CLIENT_TOKEN=
# Gemini Embeddings - HTTP timeout per provider attempt
INNA_EMBEDDING_TIMEOUT_MS=10000

# Gemini Text Generation Resilience
INNA_TEXT_GENERATION_TIMEOUT_MS=15000
INNA_TEXT_GENERATION_TOTAL_DEADLINE_MS=25000

# Agentic RAG Planner Resilience
INNA_AGENTIC_RAG_PLANNER_TIMEOUT_MS=12000
INNA_AGENTIC_RAG_PLANNER_TOTAL_DEADLINE_MS=20000

# Production Reliability Ledger
# Keep disabled until PostgreSQL/Neon live validation succeeds.
INNA_RELIABILITY_LEDGER_ENABLED=false
INNA_RELIABILITY_LEDGER_QUEUE_SIZE=1024
INNA_RELIABILITY_LEDGER_MAX_PERSIST_ATTEMPTS=3
INNA_RELIABILITY_LEDGER_RETRY_BASE_DELAY_SECONDS=0.25

# Shared Reliability Provider
# Disabled until shared-provider live validation succeeds.
INNA_RELIABILITY_SHARED_PROVIDER_ENABLED=false
INNA_RELIABILITY_SHARED_CACHE_TTL_SECONDS=5
INNA_RELIABILITY_SHARED_MAX_STALE_SECONDS=30

# Reliability Governor enforcement
INNA_RELIABILITY_GOVERNOR_ENFORCEMENT_ENABLED=false
INNA_RELIABILITY_GOVERNOR_PLANNER_ENFORCEMENT_ENABLED=false
