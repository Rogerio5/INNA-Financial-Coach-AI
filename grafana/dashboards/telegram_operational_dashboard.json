        {
          "editorMode": "code",
          "expr": "inna:telegram_worker_error_ratio:rate5m / 0.01",
          "legendFormat": "burn rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "SLO burn rate",
      "type": "stat"
    },
