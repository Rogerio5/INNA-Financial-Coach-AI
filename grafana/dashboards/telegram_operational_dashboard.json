          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Falhas por categoria",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "Falhas",
              "component": "Componente",
              "error_category": "Categoria",
              "operation": "Operação"
            }
          }
        }
      ],
      "type": "table"
    },
